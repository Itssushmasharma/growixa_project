{
  "name": "growixa-web",
  "version": "0.1.0",
  "private": true,
  "description": "Growixa frontend — Next.js dashboard",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
