# Copy to .env and fill in local values. Never commit the real .env file.
# See docs/11-devops/LOCAL_DEVELOPMENT.md for full setup instructions.

# --- Application ---
ENVIRONMENT=local
LOG_LEVEL=info

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:CHANGE_ME@rabbitmq:5672/

# --- Database (GRX-EMAIL-004: the worker's own minimal DB layer) ---
DATABASE_URL=postgresql+asyncpg://growixa:CHANGE_ME@postgres:5432/growixa

# --- Encryption (DEC-GRX-009) ---
# Must match growixa_api's ENCRYPTION_KEY exactly — both apps encrypt/decrypt the same
# email_provider_connections rows. Has a shared local-dev default; only set here to
# override it in non-local environments.
# ENCRYPTION_KEY=CHANGE_ME_LOCAL_DEV_ONLY

# --- Public API origin (GRX-EMAIL-005: unsubscribe link embedded in outbound email) ---
# Has a http://localhost:8000 default; only set here to override it.
# API_PUBLIC_URL=https://api.example.com
