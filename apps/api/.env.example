# Copy to .env and fill in local values. Never commit the real .env file.
# See docs/11-devops/LOCAL_DEVELOPMENT.md for full setup instructions.

# --- Application ---
ENVIRONMENT=local
LOG_LEVEL=info

# --- Database ---
DATABASE_URL=postgresql+asyncpg://growixa:CHANGE_ME@postgres:5432/growixa

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:CHANGE_ME@rabbitmq:5672/

# --- Auth (DEC-GRX-014) ---
# Generate a local-only development value; never reuse a production secret here.
JWT_SIGNING_KEY=CHANGE_ME_LOCAL_DEV_ONLY
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- First admin seed (used only by the one-time seed command) ---
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=CHANGE_ME
