# Copy to .env and fill in local values. Never commit the real .env file.
# See docs/11-devops/LOCAL_DEVELOPMENT.md for full setup instructions.

# --- Application ---
ENVIRONMENT=local
LOG_LEVEL=info

# --- Database ---
DATABASE_URL=postgresql+asyncpg://growixa:CHANGE_ME@postgres:5432/growixa

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:CHANGE_ME@rabbitmq:5672/

# --- Auth (DEC-GRX-014) ---
# Generate a local-only development value; never reuse a production secret here.
JWT_SIGNING_KEY=CHANGE_ME_LOCAL_DEV_ONLY
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- First admin seed (used only by the one-time seed command) ---
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=CHANGE_ME

# --- Platform admin seed (used only by the one-time `seed_platform_admin` CLI, see
#     docs/11-devops/LOCAL_DEVELOPMENT.md) ---
PLATFORM_ADMIN_EMAIL=owner@example.com
PLATFORM_ADMIN_PASSWORD=CHANGE_ME
PLATFORM_ADMIN_FULL_NAME=Platform Owner

# --- Platform transactional email (self-registration verification link) ---
# Leave PLATFORM_SMTP_HOST empty to skip sending (registration still works; the local/
# test response body returns the raw token instead).
PLATFORM_SMTP_HOST=
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_USERNAME=
PLATFORM_SMTP_PASSWORD=
PLATFORM_SMTP_FROM_EMAIL=noreply@growixa.local
PLATFORM_SMTP_FROM_NAME=Growixa
FRONTEND_BASE_URL=http://localhost:3000

# --- Credential encryption (DEC-GRX-009) ---
# Fernet key shared with apps/worker — both encrypt/decrypt the same provider-connection
# rows (email + social + AI, as of Slice 6/DEC-GRX-026). Has a shared local-dev default;
# only set here to override it.
# ENCRYPTION_KEY=CHANGE_ME_LOCAL_DEV_ONLY

# --- Slice 6: AI Assistant (DEC-GRX-026) ---
# No env vars here on purpose: the AI provider (OpenAI/Azure OpenAI/Anthropic/Ollama),
# its API key, and its default model are all DB-configured via the platform-admin UI
# (or PUT /platform/ai-config directly) and, per account, via PUT /ai/connections — same
# encrypted-at-rest pattern as email/social provider connections above, not .env. See
# docs/11-devops/LOCAL_DEVELOPMENT.md's "AI Assistant setup" section.

# --- Slice 5: Social Publishing — Instagram Business (DEC-GRX-023) ---
# The API's own publicly-reachable base URL, used to build the Instagram OAuth
# redirect_uri — must exactly match what's registered in the Meta Developer App.
# Has a http://localhost:8000 default; only set here to override it.
# API_PUBLIC_URL=https://api.example.com
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_API_VERSION=v21.0

# --- Slice 5: Social Publishing — media storage (DEC-GRX-024) ---
# Supabase Storage project used to host post images. The bucket must be public-read
# (Instagram fetches media by plain URL) — see docs/08-security/THREAT_MODEL.md T48.
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=social-media
