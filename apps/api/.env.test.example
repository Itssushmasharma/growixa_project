ENVIRONMENT=test
LOG_LEVEL=warning

# !! SEPARATE TEST DATABASE — NEVER points to the live dev db !!
# Integration tests DELETE rows as part of fixture teardown. This ensures
# they NEVER wipe dev/seed data in the main `growixa` database.
DATABASE_URL=postgresql+asyncpg://growixa:local_dev_pg_pw@localhost:5433/growixa_test

REDIS_URL=redis://localhost:6379/1

RABBITMQ_URL=amqp://guest:local_dev_mq_pw@localhost:5672/

JWT_SIGNING_KEY=local-dev-jwt-signing-key-not-for-prod-use-only
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=CHANGE_ME
