# Growixa local development environment (Docker Compose).
# Copy to .env and fill in local-only values. Never commit the real .env file.
# See docs/11-devops/LOCAL_DEVELOPMENT.md and docs/11-devops/DOCKER_ARCHITECTURE.md.
#
# These are Compose-level variables consumed by compose.yaml to configure the
# postgres/redis/rabbitmq/api/web services. apps/api/.env.example and
# apps/web/.env.example cover the same settings for running an app outside Compose.

# --- PostgreSQL ---
POSTGRES_USER=growixa
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=growixa
POSTGRES_PORT=5432

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_MGMT_PORT=15672

# --- Host port mapping for the app services ---
API_PORT=8000
WEB_PORT=3000

# --- Auth (DEC-GRX-014) — local dev only, never reuse a real secret here ---
JWT_SIGNING_KEY=CHANGE_ME_LOCAL_DEV_ONLY
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Frontend public config (safe to expose to the browser) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Slice 5: Social Publishing — Instagram Business (DEC-GRX-023) ---
# From your Meta Developer App. Read by both the api and worker services (compose.yaml
# passes these through to both containers) — leave empty to leave OAuth connect/publish
# disabled locally.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_API_VERSION=v21.0
# Must exactly match the redirect_uri registered in the Meta Developer App.
API_PUBLIC_URL=http://localhost:8000

# --- Slice 5: Social Publishing — media storage (DEC-GRX-024) ---
# Supabase Storage project used to host post images. The bucket must be public-read
# (Instagram fetches media by plain URL) — see docs/08-security/THREAT_MODEL.md T48.
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=social-media

# --- Google OAuth 2.0 / SSO (GRX-AUTH-006) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
