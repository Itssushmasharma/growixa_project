{
  "no-repeat-expensive-commands": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/pre_tool_guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },

  "tracker-update-reminder": {
    "Stop": [
      {
        "type": "command",
        "command": "./scripts/stop_guard.sh",
        "timeout": 10
      }
    ]
  }
}
